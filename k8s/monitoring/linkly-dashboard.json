{
  "title": "Linkly API — RED overview",
  "uid": "linkly-red",
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "tags": ["linkly", "red"],
  "panels": [
    {
      "type": "stat",
      "title": "Requests / s",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "targets": [{ "expr": "sum(rate(linkly_http_request_duration_seconds_count[5m]))" }]
    },
    {
      "type": "stat",
      "title": "Error rate (5xx)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [{ "expr": "sum(rate(linkly_http_request_duration_seconds_count{status=~\"5..\"}[5m])) / clamp_min(sum(rate(linkly_http_request_duration_seconds_count[5m])), 1e-9)" }]
    },
    {
      "type": "stat",
      "title": "p95 latency",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(linkly_http_request_duration_seconds_bucket[5m])))" }]
    },
    {
      "type": "stat",
      "title": "Ready API pods",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 },
      "targets": [{ "expr": "count(up{job=\"linkly-api\"} == 1)" }]
    },
    {
      "type": "timeseries",
      "title": "Requests by route",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 9 },
      "targets": [{ "expr": "sum by (route) (rate(linkly_http_request_duration_seconds_count[5m]))", "legendFormat": "{{route}}" }]
    },
    {
      "type": "timeseries",
      "title": "Latency percentiles",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 9 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(linkly_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(linkly_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(linkly_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p99" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Business: links created & redirects",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(rate(linkly_links_created_total[5m]))", "legendFormat": "links created/s" },
        { "expr": "sum by (result) (rate(linkly_redirects_total[5m]))", "legendFormat": "redirect {{result}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory per pod",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [{ "expr": "linkly_process_resident_memory_bytes", "legendFormat": "{{pod}}" }]
    }
  ]
}
